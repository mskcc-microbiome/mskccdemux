/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    amplicon-demux: Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Input
    samplesheet = null   // CSV with columns: pool,R1,R2,oligos

    // Output
    outdir      = 'results'

    // Resource defaults
    max_cpus    = 16
    max_memory  = '64.GB'
    max_time    = '24.h'
    cutadapt_min_overlap                      = 3
    cutadapt_max_error_rate                   = 0.1
    cutadapt_min_length                   = 100
}

// Process resource defaults
process {
    cpus   = { 1 * task.attempt }
    memory = { 2.GB * task.attempt }
    time   = { 1.h * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    // Publish demuxed FASTQs
    withName: 'MERGE_DEMUX' {
        ext.prefix = { "${meta.sample_id}.merged" }
        publishDir = [
            path: { "${params.outdir}/demux/merged/" },
            mode: 'copy'
        ]
    }
    withName: 'CUTADAPT_DEMUX' {
        publishDir = [
            path: { "${params.outdir}/demux/demux_round1/" },
            mode: 'copy'
        ]
    }
    withName: 'CUTADAPT_DEMUX_RC' {
        publishDir = [
            path: { "${params.outdir}/demux/demux_round2/" },
            mode: 'copy'
        ]
    }
    withName: 'SEQKIT_STATS_MERGED' {
        ext.prefix = { "${meta.sample_id}.merged" }
        publishDir = [
            path: { "${params.outdir}/demux/seqkit_merged/" },
            mode: 'copy'
        ]
    }
    withName: 'SEQKIT_STATS' {
        ext.prefix = { "${meta.sample_id}.noprimers" }
        publishDir = [
            path: { "${params.outdir}/demux/seqkit_final/" },
            mode: 'copy'
        ]
    }
    withName: 'CUTADAPT_REMOVEPRIMERS' {
       ext.args = { [
            "--minimum-length ${params.cutadapt_min_length}",
            "-O ${params.cutadapt_min_overlap}",
            "-e ${params.cutadapt_max_error_rate}",
            "-a ${meta.fw_primer}...${meta.rv_primer_revcomp}",
            "-a ${meta.rv_primer}...${meta.fw_primer_revcomp}",
            "--discard-untrimmed"
        ].join(' ').trim() }
        ext.prefix = { "${meta.sample_id}.noprimers" }
        publishDir = [
            path: { "${params.outdir}/demux/noprimers/" },
            mode: 'copy'
        ]
    }
    withName: 'OUTPUT_MANIFEST' {
        publishDir = [
            path: { "${params.outdir}/demux" },
            mode: 'copy'
        ]
    }
    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/demux/fastqc_reports" },
            mode: 'copy'
        ]
    }
    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/demux/multiqc" },
            mode: 'copy'
        ]
    }
}

// Container engine
docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Profiles
profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        docker.enabled      = false
    }
    test {
        params.samplesheet = "${projectDir}/assets/input.csv"
    }
}

// Manifest
manifest {
    name            = 'amplicon-demux'
    description     = 'Two-round amplicon demultiplexing with cutadapt'
    version         = '1.0.0'
    nextflowVersion = '!>=24.04.0'
    mainScript      = 'main.nf'
}
